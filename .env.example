POSTGRES_DB=digital_twin
POSTGRES_USER=twin
POSTGRES_PASSWORD=
NEO4J_PASSWORD=
TWIN_STALE_AFTER_SECONDS=180
TWIN_MAX_PATH_DEPTH=8
TWIN_EMULATION_API_TOKEN=
TWIN_AUTH_MODE=tokens
# HTTP cookies are permitted only for the loopback local setup.
TWIN_COOKIE_SECURE=false
TWIN_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
TWIN_AGENT_BIND=127.0.0.1
TWIN_MAX_RUN_CPU_MILLIS=2000
TWIN_MAX_RUN_RAM_MB=4096
TWIN_MAX_PENDING_RUNS=10

# Fair-share cap on queued/running sandbox runs per tenant.
TWIN_MAX_TENANT_PENDING_RUNS=3
# Admins of this tenant can read platform-wide Prometheus metrics.
TWIN_OPERATOR_TENANT=default
# TwinHunter model: Gemini 3.8 Flash through OmniRoute (primary). Use 'local' for pinned Qwen.
TWIN_MODEL_BACKEND=omniroute
TWIN_MODEL_ENDPOINT=http://127.0.0.1:20128/v1
TWIN_MODEL_ID=lynx-harness
TWIN_MODEL_EXPECTED=gemini-3.8-flash
# Set privately; never commit.
TWIN_MODEL_API_KEY=
# Address and TLS name enrolling agents are told to use for gRPC telemetry.
TWIN_PUBLIC_GRPC_ADDRESS=localhost:8443
TWIN_GRPC_SERVER_NAME=ingestion.local
