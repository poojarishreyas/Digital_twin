{
  "name": "@elemental/plugin-package-inventory-deepseek",
  "description": "Active Loader-backed plugin package inventory for official deepseek LLM API requests",
  "version": "0.1.2-alpha.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/poojarishreyas/Elemental_harness.git",
    "directory": "packages/llm/plugin-package-inventory-deepseek"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@elemental/brand": "workspace:^",
    "@elemental/schemastery": "workspace:^"
  },
  "peerDependencies": {
    "@elemental/cordis": "workspace:^",
    "@elemental/cordis-plugin-loader": "workspace:^",
    "@elemental/agent": "workspace:^",
    "@elemental/agent-presets": "workspace:^",
    "@elemental/deepseek-llm-api-extensions": "workspace:^",
    "@elemental/invariants": "workspace:^",
    "@elemental/session": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@elemental/agent-presets": {
      "optional": true
    }
  },
  "devDependencies": {
    "@elemental/cordis": "workspace:^",
    "@elemental/cordis-plugin-include": "workspace:^",
    "@elemental/cordis-plugin-loader": "workspace:^",
    "@elemental/agent": "workspace:^",
    "@elemental/agent-presets": "workspace:^",
    "@elemental/deepseek-llm-api-extensions": "workspace:^",
    "@elemental/invariants": "workspace:^",
    "@elemental/scope": "workspace:^",
    "@elemental/session": "workspace:^",
    "@elemental/session-projection": "workspace:^"
  }
}