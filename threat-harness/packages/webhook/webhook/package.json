{
  "name": "@elemental/webhook",
  "description": "Fire-and-forget webhook rule runtime that creates Workspace-backed Elemental Harness Sessions",
  "version": "0.1.2-alpha.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/poojarishreyas/Elemental_harness.git",
    "directory": "packages/webhook/webhook"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@elemental/cordis": "workspace:^",
    "@elemental/agent": "workspace:^",
    "@elemental/agent-default-model": "workspace:^",
    "@elemental/agent-presets": "workspace:^",
    "@elemental/invariants": "workspace:^",
    "@elemental/llm": "workspace:^",
    "@elemental/permission-presets": "workspace:^",
    "@elemental/session": "workspace:^",
    "@elemental/session-title": "workspace:^",
    "@elemental/workspace": "workspace:^"
  },
  "devDependencies": {
    "@elemental/cordis": "workspace:^",
    "@elemental/cordis-plugin-include": "workspace:^",
    "@elemental/cordis-plugin-loader": "workspace:^",
    "@elemental/agent": "workspace:^",
    "@elemental/agent-default-model": "workspace:^",
    "@elemental/agent-presets": "workspace:^",
    "@elemental/invariants": "workspace:^",
    "@elemental/llm": "workspace:^",
    "@elemental/permission-presets": "workspace:^",
    "@elemental/session": "workspace:^",
    "@elemental/session-title": "workspace:^",
    "@elemental/workspace": "workspace:^"
  },
  "dependencies": {
    "@elemental/brand": "workspace:^",
    "@elemental/util-values": "workspace:^"
  }
}