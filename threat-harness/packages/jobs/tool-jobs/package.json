    "@elemental/output-retention": "workspace:^",
    "@elemental/system-prompt": "workspace:^",
    "@elemental/jobs": "workspace:^",
    "@elemental/tools": "workspace:^",
    "@elemental/cordis": "workspace:^"
  },
  "devDependencies": {
    "@elemental/agent": "workspace:^",
    "@elemental/invariants": "workspace:^",
    "@elemental/llm": "workspace:^",
    "@elemental/output-retention": "workspace:^",
    "@elemental/session": "workspace:^",
    "@elemental/system-prompt": "workspace:^",
    "@elemental/jobs": "workspace:^",
    "@elemental/jobs-local": "workspace:^",
    "@elemental/tools": "workspace:^",
    "@elemental/cordis": "workspace:^"
  }
}