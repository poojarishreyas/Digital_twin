{
  "name": "@elemental/shell-permission-policy",
  "description": "Permission policy for model-run shell commands: allow/ask/deny rules, a read-only allowlist, approval prompts with saved workspace rules, and the opt-in OS sandbox with excluded commands",
  "version": "0.1.2-alpha.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/poojarishreyas/Elemental_harness.git",
    "directory": "packages/shell/shell-permission-policy"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@elemental/agent": "workspace:^",
    "@elemental/invariants": "workspace:^",
    "@elemental/sandbox": "workspace:^",
    "@elemental/session": "workspace:^",
    "@elemental/settings": "workspace:^",
    "@elemental/shell": "workspace:^",
    "@elemental/tools": "workspace:^",
    "@elemental/user-approval": "workspace:^",
    "@elemental/util-values": "workspace:^",
    "@elemental/cordis": "workspace:^"
  },
  "dependencies": {
    "@elemental/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@elemental/cordis": "workspace:^",
    "@elemental/agent": "workspace:^",
    "@elemental/app-boot": "workspace:^",
    "@elemental/bash-local": "workspace:^",
    "@elemental/invariants": "workspace:^",
    "@elemental/llm": "workspace:^",
    "@elemental/loader-smoke": "workspace:^",
    "@elemental/pwsh-local": "workspace:^",
    "@elemental/sandbox": "workspace:^",
    "@elemental/session": "workspace:^",
    "@elemental/settings": "workspace:^",
    "@elemental/shell": "workspace:^",
    "@elemental/shell-env": "workspace:^",
    "@elemental/subprocess-local": "workspace:^",
    "@elemental/system-prompt": "workspace:^",
    "@elemental/tool-bash": "workspace:^",
    "@elemental/tool-pwsh": "workspace:^",
    "@elemental/tools": "workspace:^",
    "@elemental/user-approval": "workspace:^",
    "@elemental/util-values": "workspace:^"
  }
}
