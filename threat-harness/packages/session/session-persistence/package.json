    "@elemental/timeout": "workspace:^"
  },
  "devDependencies": {
    "@elemental/cordis": "workspace:^",
    "@elemental/brand": "workspace:^",
    "@elemental/invariants": "workspace:^",
    "@elemental/scope": "workspace:^",
    "@elemental/session": "workspace:^",
    "@elemental/timeout": "workspace:^"
  },
  "dependencies": {
    "@elemental/util-values": "workspace:^"
  }
