{
  "name": "@elemental/client-ui-chat",
  "description": "Chat Conversation target, node definitions, renderers, and details surface",
  "version": "0.1.2-alpha.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/poojarishreyas/Elemental_harness.git",
    "directory": "packages/client/ui-chat"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "elemental": {
    "client": {
      "inject": [
        "@elemental/api-session-controller",
        "@elemental/api-workspace-controller",
        "@elemental/client-locale",
        "@elemental/client-ui-conversation",
        "@elemental/client-ui-layout",
        "@elemental/client-ui-renderer",
        "@elemental/client-ui-session",
        "@elemental/client-ui-settings",
        "@elemental/client-ui-workspace"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@elemental/cordis": "workspace:^"
  },
  "devDependencies": {
    "@elemental/cordis": "workspace:^",
    "@elemental/agent": "workspace:^",
    "@elemental/api-remotes": "workspace:^",
    "@elemental/api-session-controller": "workspace:^",
    "@elemental/api-workspace-controller": "workspace:^",
    "@elemental/attachment": "workspace:^",
    "@elemental/client-locale": "workspace:^",
    "@elemental/client-store": "workspace:^",
    "@elemental/client-ui-approval": "workspace:^",
    "@elemental/client-ui-conversation": "workspace:^",
    "@elemental/client-ui-layout": "workspace:^",
    "@elemental/client-ui-primitives": "workspace:^",
    "@elemental/client-ui-renderer": "workspace:^",
    "@elemental/client-ui-session": "workspace:^",
    "@elemental/client-ui-settings": "workspace:^",
    "@elemental/client-ui-slots": "workspace:^",
    "@elemental/client-ui-workspace": "workspace:^",
    "@elemental/commands": "workspace:^",
    "@elemental/compaction": "workspace:^",
    "@elemental/invariants": "workspace:^",
    "@elemental/llm": "workspace:^",
    "@elemental/llm-retry": "workspace:^",
    "@elemental/session": "workspace:^",
    "@elemental/session-stats": "workspace:^",
    "@elemental/session-turn-outline": "workspace:^",
    "@elemental/token-meter": "workspace:^",
    "@elemental/tools": "workspace:^",
    "@elemental/util-workspace-path": "workspace:^",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@elemental/settings": "workspace:^"
  },
  "dependencies": {
    "@elemental/schemastery": "workspace:^"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
