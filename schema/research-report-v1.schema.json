    },
    "budgets": {
      "title": "Budgets",
      "type": "object"
    },
    "environment": {
      "title": "Environment",
      "type": "object"
    },
    "rows": {
      "items": {
        "type": "object"
      },
      "title": "Rows",
      "type": "array"
    },
    "patches": {
      "default": [],
      "items": {
        "type": "object"
      },
      "title": "Patches",
      "type": "array"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
